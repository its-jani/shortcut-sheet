{
  "$schema": "./tokens.schema.md",
  "meta": {
    "project": "shortcut-sheet",
    "derived_from": "replica/recon.md S01/S02/S04/S05 measurements",
    "clean_room": "Values are our own. Informed by the WinUI 3 visual language the original uses, not lifted from its resources. No third-party color list, no original asset.",
    "unit": "logical px at 100% scale; multiply by per-monitor DPI factor at paint time",
    "status": "provisional - overlay geometry measured from public reference shots, not a live capture (see recon.md Gaps)"
  },
  "color": {
    "overlay": {
      "surface": { "light": "#F7F7F7", "dark": "#1F1F1F" },
      "surface_alpha": { "light": 0.97, "dark": 0.96 },
      "card": { "light": "#FFFFFF", "dark": "#2A2A2A" },
      "border": { "light": "#E3E3E3", "dark": "#383838" },
      "border_strong": { "light": "#CFCFCF", "dark": "#484848" },
      "shadow": { "light": "#00000026", "dark": "#00000059" }
    },
    "text": {
      "primary": { "light": "#1A1A1A", "dark": "#F2F2F2" },
      "secondary": { "light": "#5C5C5C", "dark": "#A3A3A3" },
      "tertiary": { "light": "#757575", "dark": "#9A9A9A" },
      "on-accent": { "light": "#FFFFFF", "dark": "#121212" }
    },
    "accent": {
      "base": { "light": "#3C6E9F", "dark": "#7FAECE" },
      "hover": { "light": "#345F8A", "dark": "#93BBD8" },
      "muted": { "light": "#3C6E9F22", "dark": "#7FAECE2E" },
      "note": "Deliberately not the OS-default blue; our own brand ramp."
    },
    "keycap": {
      "fill": { "light": "#EFEFEF", "dark": "#353535" },
      "fill_pressed": { "light": "#DCE6EF", "dark": "#3D4A56" },
      "border": { "light": "#D4D4D4", "dark": "#4A4A4A" },
      "text": { "light": "#2B2B2B", "dark": "#E8E8E8" },
      "mono": true
    },
    "state": {
      "row_hover": { "light": "#0000000A", "dark": "#FFFFFF0F" },
      "row_selected": { "light": "#3C6E9F1F", "dark": "#7FAECE26" },
      "success": { "light": "#2E7D46", "dark": "#6FCB8A" },
      "danger": { "light": "#B3403A", "dark": "#E8877F" },
      "mastery-learnt": { "light": "#8F6114", "dark": "#D9A94F" }
    }
  },
  "type": {
    "family": "Segoe UI Variable Display, Segoe UI, sans-serif",
    "family_keycap": "Cascadia Mono, Consolas, monospace",
    "scale": { "xs": 11, "sm": 12, "md": 14, "lg": 16, "xl": 20, "2xl": 28, "3xl": 36 },
    "weights": { "regular": 400, "semibold": 600 },
    "line_height_ratio": 1.35,
    "roles": {
      "command_name": { "size": "md", "weight": "regular", "color": "text.primary" },
      "collection_header": { "size": "sm", "weight": "semibold", "color": "text.secondary", "tracking": 0.3 },
      "overlay_title": { "size": "sm", "weight": "semibold", "color": "text.primary" },
      "drill_command": { "size": "3xl", "weight": "regular", "color": "text.primary" },
      "count": { "size": "xs", "weight": "regular", "color": "text.tertiary" }
    }
  },
  "space": {
    "unit": 4,
    "scale": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32 },
    "overlay_padding": 12,
    "overlay_row_gap": 2,
    "overlay_section_gap": 10,
    "hub_page_padding": 24,
    "hub_grid_gap": 12,
    "card_padding": 14
  },
  "radius": { "xs": 3, "sm": 4, "md": 6, "lg": 8, "xl": 12, "pill": 999 },
  "size": {
    "overlay_width": 344,
    "overlay_max_height": 424,
    "overlay_min_rows_visible": 6,
    "row_height": 32,
    "keycap_height": 20,
    "keycap_min_width": 20,
    "keycap_gap": 4,
    "title_bar_height": 32,
    "search_height": 30,
    "drill_keycap_height": 52,
    "hub_card_min_width": 168,
    "hub_icon": 44,
    "tray_icon": 16
  },
  "stroke": { "hairline": 1, "focus": 2, "search_underline": 2 },
  "elevation": {
    "overlay_shadow": { "offset_y": 8, "blur": 24, "color": "overlay.shadow" },
    "card_shadow": { "offset_y": 1, "blur": 3, "color": "#00000014" }
  },
  "motion": {
    "show_fade_ms": 90,
    "hide_fade_ms": 60,
    "hover_ms": 60,
    "drill_correct_ms": 160,
    "drill_wrong_shake_px": 4,
    "easing": "ease-out",
    "note": "Overlay appears on a key hold; any animation longer than ~100ms reads as lag. Keep show under 100ms."
  },
  "component": {
    "overlay_row": {
      "layout": "command name left, keycap cluster right, baseline aligned",
      "truncate": "command name ellipsizes at 60% of overlay width, keycaps never truncate",
      "states": ["default", "hover", "keyboard-selected", "firing"],
      "parity_note": "recon S01: name is regular weight, keycaps right-aligned in a tight cluster"
    },
    "keycap": {
      "render_rules": [
        "Control renders as the WORD 'Ctrl'",
        "Shift renders as the GLYPH 'Shift'",
        "Windows renders as the GLYPH 'Win'",
        "Alt renders as the WORD 'Alt'",
        "single characters render uppercase, monospaced",
        "navigation keys render arrow glyphs, function keys as F1..F24"
      ],
      "parity_note": "The original mixes word CTRL with glyph Shift; we use words for all modifiers for consistency - intentional divergence, logged in features.csv notes",
      "shape": "rounded rect, fill + hairline border, no drop shadow"
    },
    "search_box": {
      "placeholder": "Search",
      "underline": "2px accent when focused, 1px border otherwise",
      "focus_behavior": "DECIDED: clicking the field calls Activate() on the overlay - deliberate focus change. Escape or blur returns focus to the saved target hwnd.",
      "clear": "Escape clears text first, then closes overlay"
    },
    "collection_header": { "sticky": true, "case": "as authored", "divider": true },
    "app_card": {
      "content": "icon tile, app name, 'n / m mastered'",
      "icon_fallback": "letter avatar on accent.muted - never a third-party logo",
      "states": ["default", "hover", "partial", "complete"]
    },
    "drill_keycap": {
      "states": ["idle", "held", "correct", "wrong"],
      "held": "fill_pressed + 1px inset",
      "correct": "state.success border, 160ms",
      "wrong": "state.danger border + 4px shake"
    }
  },
  "layout": {
    "overlay_placement": "centered on the FOREGROUND WINDOW rect, not the work area or screen",
    "offscreen_clamp": "if the target rect is offscreen or minimized, clamp to the nearest monitor work area with 16px inset",
    "z_order": "topmost, non-activated by default",
    "taskbar": "never appears in alt-tab or the taskbar (WS_EX_TOOLWINDOW)"
  },
  "pairs": [
    ["text-primary-light", "overlay-surface-light"],
    ["text-primary-light", "overlay-card-light"],
    ["text-secondary-light", "overlay-surface-light"],
    ["text-secondary-light", "overlay-card-light"],
    ["text-tertiary-light", "overlay-card-light"],
    ["keycap-text-light", "keycap-fill-light"],
    ["accent-base-light", "overlay-card-light"],
    ["state-success-light", "overlay-card-light"],
    ["state-danger-light", "overlay-card-light"],
    ["state-mastery-learnt-light", "overlay-card-light"],
    ["text-on-accent-light", "accent-base-light"],
    ["text-primary-dark", "overlay-surface-dark"],
    ["text-primary-dark", "overlay-card-dark"],
    ["text-secondary-dark", "overlay-surface-dark"],
    ["text-secondary-dark", "overlay-card-dark"],
    ["text-tertiary-dark", "overlay-card-dark"],
    ["keycap-text-dark", "keycap-fill-dark"],
    ["accent-base-dark", "overlay-card-dark"],
    ["state-success-dark", "overlay-card-dark"],
    ["state-danger-dark", "overlay-card-dark"],
    ["state-mastery-learnt-dark", "overlay-card-dark"],
    ["text-on-accent-dark", "accent-base-dark"],
    ["accent-base-light", "overlay-card-light", "ui"],
    ["accent-base-dark", "overlay-card-dark", "ui"]
  ],
  "accessibility": {
    "contrast_target": "WCAG AA 4.5:1 for text.primary, secondary and tertiary on both themes - verified with replica-design/contrast.py",
    "min_touch_target": 24,
    "keyboard": "Up/Down move selection, Enter fires, Escape closes, typing focuses search",
    "reduced_motion": "honor the OS setting: drop all fades and the shake"
  }
}
